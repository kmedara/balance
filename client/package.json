{
  "name": "balance",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/write-environment.mjs",
    "start": "ng serve --configuration development --host 0.0.0.0 --poll 1",
    "prebuild": "node scripts/write-environment.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "serve:ssr:angular": "node dist/angular/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^21.0.1",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.1.2",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.1.2",
    "@angular/forms": "^21.1.2",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.1.2",
    "@angular/platform-server": "^21.1.2",
    "@angular/router": "^21.1.2",
    "@angular/ssr": "^21.1.2",
    "@balance/domain": "*",
    "@balance/schemas": "*",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/signals": "^21.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "plaid": "^41.1.0",
    "postcss": "^8.5.6",
    "rrule": "^2.8.1",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/animations": "^21.1.2",
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.2",
    "@eslint/js": "^10.0.1",
    "@ngrx/signals": "^21.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^25.2.2",
    "@types/plaid-link": "^2.0.15",
    "@vitest/ui": "^4.0.18",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18"
  }
}
